# esign backend configuration — copy to .env and fill in. NEVER commit the real .env.

# Postgres connection string
DATABASE_URL=postgres://esign:CHANGE_ME@localhost:5432/esign

# AWS (S3 for document storage, SES for email). On EC2/ECS prefer an instance/task role
# over static keys; locally the default AWS credential chain (~/.aws) is used.
AWS_REGION=us-east-1
S3_BUCKET=your-esign-bucket-name

# Signing-link JWT secret — use a long random value in production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public base URL the signer opens (goes into the emailed link)
APP_BASE_URL=http://localhost:5173

# Email: 'console' (dev, logs only) or 'ses' (real send via Amazon SES)
EMAIL_MODE=console
SES_FROM=esign@yourdomain.com
SES_FROM_NAME=esign
SES_REPLY_TO=esign@yourdomain.com
# SES configuration set — routes bounce/complaint events to SNS so a failed
# delivery is visible instead of silent. Optional but recommended in production.
SES_CONFIGURATION_SET=
# Display name used in "<name> has sent you a document to sign".
# Falls back to the document's sender_email, then SES_FROM.
SENDER_NAME=

# Sender auth: set a password to REQUIRE login for the sender UI.
# Leave unset/empty to disable auth (dev only).
# REQUIRED when NODE_ENV=production — the server refuses to start without it.
SENDER_PASSWORD=

# Backend port
PORT=4000
